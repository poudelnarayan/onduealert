# Prisma uses a Postgres connection string (NOT Supabase API keys).
# Supabase: Project Settings -> Database -> Connection string -> URI (Direct connection recommended).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional but recommended when using Supabase:
# - Set DATABASE_URL to the pooled/transaction string (if you want pooling)
# - Set DIRECT_URL to the direct connection string (used by Prisma for migrations/introspection)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Clerk (store real values in .env.local, not in tracked files)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Supabase (server-side only)
# SUPABASE_URL=YOUR_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET_PROOFS=proofs

# Email (pick one)
# EMAIL_MODE="console"
# or SMTP:
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="user@example.com"
# SMTP_PASS="password"
# EMAIL_FROM="OnDueAlert <no-reply@example.com>"

# Cron (Vercel Cron should call /api/cron/send-notifications?token=...)
CRON_SECRET="replace-with-a-long-random-secret"

